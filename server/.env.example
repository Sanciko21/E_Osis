# =====================================================================
# E-OSIS — konfigurasi backend (salin menjadi server/.env lalu isi nilainya)
# File .env berisi rahasia: JANGAN di-commit dan JANGAN dipakai di frontend.
# =====================================================================

# ---------- Server ----------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Origin frontend yang diizinkan (pisahkan dengan koma). Saat dev, Vite memakai proxy
# sehingga origin-nya sama dengan backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Isi jumlah reverse proxy di depan aplikasi (mis. 1 untuk Nginx) agar IP klien benar.
TRUST_PROXY=false

# ---------- Database PostgreSQL / Supabase ----------
# Supabase: dashboard proyek → Connect → "Session pooler" → View parameters.
#   Jangan memakai Transaction pooler (port 6543). Koneksi langsung (db.<ref>.supabase.co)
#   hanya IPv6; bila dipakai, user tanpa akhiran ".<project-ref>".
# PostgreSQL lokal: DB_HOST=127.0.0.1, DB_PORT=5432, user tanpa akhiran.
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# Semua tabel E-OSIS ada di skema ini (bukan "public", yang dibuka Data API Supabase).
DB_SCHEMA=eosis
# disable | require | verify-full. Kosong = disable untuk host lokal, require untuk host lain.
DB_SSL=require
# Untuk verify-full: sertifikat CA dari Supabase (Database Settings → SSL Configuration).
DB_SSL_CA=
# Harus di bawah "Pool Size" pooler Supabase.
DB_CONNECTION_LIMIT=10

# ---------- Database: akun APLIKASI (hak akses minimum) ----------
# Password berisi #, spasi, atau tanda kutip WAJIB diapit kutip ganda, mis. "Ab#cd 12"
# (tanpa kutip, semua setelah # dianggap komentar).
# Role dibuat & diberi hak otomatis oleh "npm run db:setup". Lewat pooler: <role>.<project-ref>
DB_USER=eosis_app.ganti_project_ref
DB_PASSWORD=ganti_dengan_password_acak_yang_kuat

# ---------- Database: akun MIGRASI (hanya untuk skrip CLI db:*, admin:*) ----------
# Akun berhak DDL/GRANT: user "postgres" proyek Supabase + database password proyek
# (PostgreSQL lokal: postgres). Tidak pernah dipakai server yang berjalan.
DB_MIGRATION_USER=postgres.ganti_project_ref
DB_MIGRATION_PASSWORD=

# ---------- Sesi admin ----------
# Wajib true di production (HTTPS). Default: true bila NODE_ENV=production.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# ---------- Rate limit (per IP) ----------
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Siswa di lab komputer sering berbagi satu IP publik: sesuaikan dengan kondisi sekolah.
VOTE_RATE_LIMIT_MAX=60
VOTE_RATE_LIMIT_WINDOW_MINUTES=1
API_RATE_LIMIT_MAX=600

# ---------- Aturan NISN ----------
# Nasional: tepat 10 digit. Pola sekolah hanya boleh MEMPERKETAT, mis. ^01[0-4][0-9]{7}$
NISN_PATTERN=^[0-9]{10}$

# ---------- Upload foto kandidat ----------
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=2

# ---------- Menyajikan build frontend dari Express (opsional, mode satu server) ----------
SERVE_CLIENT=false
CLIENT_DIST_DIR=../client/dist

# ---------- Seed akun lokal (opsional; kosong = password acak ditampilkan sekali) ----------
SEED_ADMIN_EMAIL=admin@eosis.local
SEED_ADMIN_PASSWORD=
SEED_OBSERVER_EMAIL=pengawas@eosis.local
SEED_OBSERVER_PASSWORD=
