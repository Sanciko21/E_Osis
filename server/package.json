{
  "name": "e-osis-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API E-OSIS (Node.js + Express + PostgreSQL/Supabase)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "node scripts/db-create.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:grants": "node scripts/db-grants.js",
    "db:setup": "node scripts/db-setup.js",
    "db:reset": "node scripts/db-reset.js",
    "db:sql": "node scripts/db-sql.js",
    "db:seed": "node seeds/seed-admin.js",
    "db:seed:demo": "node seeds/seed-demo.js",
    "admin:create": "node scripts/admin-user.js create",
    "admin:list": "node scripts/admin-user.js list",
    "admin:reset-password": "node scripts/admin-user.js reset-password",
    "admin:deactivate": "node scripts/admin-user.js deactivate",
    "admin:activate": "node scripts/admin-user.js activate",
    "admin:sql": "node scripts/admin-user.js sql"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^7.3.7"
  }
}
