# =====================================================================
# E-OSIS — Edge Function Secrets (salin menjadi supabase/.env.production, isi, lalu jalankan:
#   npx supabase secrets set --env-file supabase/.env.production
# File .env.production berisi rahasia: JANGAN di-commit (sudah diabaikan .gitignore).
# SUPABASE_URL & kunci server Supabase disediakan otomatis oleh Supabase — jangan diisi di sini.
# =====================================================================

# Transaction pooler Supabase (Connect → Transaction pooler). Host sama dengan Session pooler,
# port 6543. User = eosis_app.<project-ref>; password = DB_PASSWORD di server/.env.
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_SCHEMA=eosis
DB_SSL=require
DB_USER=eosis_app.ganti_project_ref
DB_PASSWORD=ganti_dengan_password_eosis_app

# Domain frontend di Vercel (pisahkan dengan koma bila lebih dari satu, tanpa garis miring di akhir).
CORS_ORIGINS=https://ganti-nama-proyek.vercel.app

# Opsional (bawaan Edge sudah diatur di supabase/functions/api/index.js):
# NISN_PATTERN=^[0-9]{10}$
# VOTE_RATE_LIMIT_MAX=600
# API_RATE_LIMIT_MAX=6000
# TRUST_PROXY=10
# DB_CONNECTION_LIMIT=3
# SESSION_IDLE_MINUTES=30
