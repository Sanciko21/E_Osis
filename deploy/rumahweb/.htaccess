# E-OSIS — konfigurasi Apache/LiteSpeed untuk hosting cPanel (Rumahweb).
# Dibuat oleh `npm run build:rumahweb` dari deploy/rumahweb/.htaccess — ubah templatnya.

# Sengaja tanpa "Options -Indexes": sebagian hosting menolak Options di .htaccess (error 500).
# Daftar isi folder tetap tertutup karena semua permintaan non-file diarahkan ke index.html.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase __BASE_PATH__

  # Wajib HTTPS: cookie sesi admin (__Host-, Secure) hanya berfungsi lewat HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /api/... → proxy PHP ke Supabase Edge Function (lihat api/index.php).
  RewriteCond %{REQUEST_FILENAME} !api/index\.php$
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

  # File & folder yang ada dilayani langsung (assets/, demo/, logo, favicon).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Selain itu: halaman aplikasi React (/admin, /pilih, /hasil, ...) → index.html.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_authz_core.c>
  <Files ".user.ini">
    Require all denied
  </Files>
</IfModule>

<IfModule mod_headers.c>
  # Tanpa includeSubDomains: subdomain lain milik sekolah mungkin belum memakai HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  # index.html selalu diperiksa ulang agar versi baru langsung terpakai setelah upload.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
