# =====================================================================
# E-OSIS — konfigurasi frontend (opsional; salin menjadi client/.env)
# PERHATIAN: semua variabel VITE_* ikut ter-bundle dan TERLIHAT di browser.
# Jangan pernah menaruh password database, session secret, atau kredensial di sini.
# =====================================================================

# Nama sekolah yang tampil di logo, hero, dan footer.
VITE_SCHOOL_NAME=

# Logo sekolah di belakang foto pasangan calon (kartu di beranda). Kosong = /logo-sekolah.png,
# yaitu file client/public/logo-sekolah.png. Boleh juga file lain di public/ atau URL https://.
# Bila file tidak ada, latar foto cukup berupa gradasi warna.
VITE_SCHOOL_LOGO_URL=

# Kosongkan bila frontend & API satu origin (disarankan). Isi hanya bila API berada
# di origin lain, mis. https://api-osis.sekolah.sch.id (atur juga CORS_ORIGINS di server).
VITE_API_BASE_URL=

# Tujuan proxy /api dan /uploads saat "npm run dev" (bukan variabel VITE_, tidak ter-bundle).
DEV_API_PROXY_TARGET=http://127.0.0.1:4000
