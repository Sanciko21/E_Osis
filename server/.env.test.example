# =====================================================================
# E-OSIS — konfigurasi PENGUJIAN (salin menjadi server/.env.test)
# Tes bersifat destruktif (TRUNCATE/DROP SCHEMA). Pengaman: tes menolak berjalan bila
# NODE_ENV bukan "test" atau DB_SCHEMA tidak berakhiran "_test". Karena hanya skema tes
# yang dibangun ulang, tes boleh memakai proyek Supabase yang sama dengan pengembangan.
# =====================================================================
NODE_ENV=test
# Supabase (Session pooler) atau PostgreSQL lokal (127.0.0.1:5432, user tanpa akhiran).
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_SCHEMA=eosis_test
DB_SSL=require
# Password berisi #, spasi, atau tanda kutip WAJIB diapit kutip ganda, mis. "Ab#cd 12"
# (tanpa kutip, semua setelah # dianggap komentar).
# Disarankan role aplikasi tersendiri (bukan eosis_app) agar tes hak akses database ikut berjalan.
DB_USER=eosis_test_app.ganti_project_ref
DB_PASSWORD=ganti_dengan_password_acak_yang_kuat
# Akun berhak DDL untuk membuat ulang skema tes.
DB_MIGRATION_USER=postgres.ganti_project_ref
DB_MIGRATION_PASSWORD=
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=1000
VOTE_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_MAX=100000
