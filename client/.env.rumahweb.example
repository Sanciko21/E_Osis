# =====================================================================
# E-OSIS — build untuk hosting cPanel Rumahweb (salin menjadi client/.env.rumahweb)
# Dipakai oleh: npm run build:rumahweb
# Tidak berisi rahasia; semua VITE_* tetap TERLIHAT di browser.
# =====================================================================

# Folder di public_html tempat aplikasi diunggah → https://domain-sekolah/E-Voting/
BASE_PATH=/E-Voting/

# URL Supabase Edge Functions (tanpa "/api" di akhir). Project ref = bagian awal URL Supabase.
SUPABASE_FUNCTIONS_URL=https://ganti_project_ref.supabase.co/functions/v1

# Opsional (sama seperti client/.env.example)
VITE_SCHOOL_NAME=
VITE_SCHOOL_LOGO_URL=
